{
  "name": "@zhuixin/shared",
  "version": "0.1.2",
  "license": "Apache-2.0",
  "description": "Shared AppTrace types and schemas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhuixin-labs/app-evidence.git",
    "directory": "packages/shared"
  },
  "publishConfig": {"access": "public"},
  "engines": {"node": ">=22.19"},
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
