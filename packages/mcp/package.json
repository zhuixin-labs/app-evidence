{
  "name": "@zhuixin/mcp",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "description": "AppTrace MCP server for evidence-backed application analysis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhuixin-labs/app-evidence.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/zhuixin-labs/app-evidence",
  "bugs": {"url": "https://github.com/zhuixin-labs/app-evidence/issues"},
  "keywords": ["mcp", "ai-agents", "app-analysis", "model-context-protocol"],
  "publishConfig": {"access": "public"},
  "engines": {"node": ">=22.19"},
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "apptrace-mcp": "dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@zhuixin/metadata": "workspace:*",
    "@zhuixin/shared": "workspace:*",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
